{
  "name": "playtest-harness",
  "private": true,
  "version": "0.9.80",
  "type": "module",
  "description": "可移植核心的 3D 玩法实验台：碰撞白盒场景 + 体素角色 + 2.5D 平滑跟随相机 + 隐形摇杆",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:affected": "node scripts/test-affected.mjs",
    "test:affected:list": "node scripts/test-affected.mjs --list",
    "test:watch": "vitest",
    "check:boundary": "node scripts/check-boundary.mjs",
    "verify:portable": "vitest run tests/portable.test.ts && node scripts/check-boundary.mjs",
    "verify": "npm run build && npm test && npm run verify:portable && npm run docs:check && npm run smoke",
    "clip:lab": "python3 tools/clip-lab/clip_lab.py",
    "clip:lab:check": "python3 tools/clip-lab/clip_lab.py check",
    "clip:lab:selftest": "python3 tools/clip-lab/clip_lab.py selftest",
    "smoke": "python3 tools/smoke.py",
    "publish:preview": "node tools/publish-preview.mjs",
    "publish:pages": "python3.11 tools/publish-pages.py",
    "ship": "bash tools/ship.sh",
    "feat:start": "python3.11 tools/agent-sync.py start",
    "feat:finish": "python3.11 tools/agent-sync.py finish",
    "feat:status": "python3.11 tools/agent-sync.py status",
    "sweep": "python3 tools/sweep_sample.py",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.19.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}

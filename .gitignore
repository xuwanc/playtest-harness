# 依赖（90M，绝不入库）
node_modules/

# 说明：dist/ 有意保留入库，供 GitHub Pages 直接部署

# 本地环境与密钥
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 日志 / 缓存 / 覆盖率
*.log
npm-debug.log*
.vite/
coverage/
*.tsbuildinfo

# clip-lab 产物（报告 / 截图是本地证据，不入库；工具本体在 tools/clip-lab/）
/clip-lab/

# Python 缓存
__pycache__/
*.pyc

# 本轮验收截图（本地证据，不入库；历史 preview-*.png 例外，已长期跟踪）
shots*/

# 本地令牌 / 提交网关凭据（绝不入库）
.gh_pat*
gh-token*
# 截图 / 录屏（本地证据，一律不入库）
# 统一放 shots/<批次>/：legacy（历史 preview-*）、v9s38 / v9s39（每轮验收）、diag（临时诊断）
/shots/
# 根目录不再接受零散图片（历史上一度堆了 41 张 preview-*.png）
/*.png
/*.jpg
/*.jpeg
/*.webp
